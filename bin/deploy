#!/usr/bin/env sh
# Deploy what's on GitHub's main branch to the production server: pull, rebuild, restart.
# Run from your machine; it does the work on the server over SSH.
#
#   bin/deploy                              uses the ssh host "milty" (see README for the ~/.ssh/config entry)
#   DEPLOY_HOST=root@1.2.3.4 bin/deploy     or point it at any host
#
#   DEPLOY_DIR   checkout location on the server (default: miltydraftplus, relative to the login's home)

set -e
cd "$(dirname "$0")/.."

HOST=${DEPLOY_HOST:-milty}
DIR=${DEPLOY_DIR:-miltydraftplus}

# The server pulls from GitHub, so anything not pushed won't be deployed
git fetch -q origin main
if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]; then
    echo "Warning: your current commit isn't origin/main; deploying origin/main ($(git log -1 --format='%h %s' origin/main))"
fi

ssh "$HOST" "DIR='$DIR' sh -s" <<'REMOTE'
set -e
cd "$DIR"
git pull --ff-only
docker compose -f deploy/docker-compose.prod.yml up -d --build
docker image prune -f >/dev/null
echo
echo "Deployed $(git log -1 --format='%h %s')"
docker compose -f deploy/docker-compose.prod.yml ps --format '{{.Name}}: {{.Status}}'
REMOTE
